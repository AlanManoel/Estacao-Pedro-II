{
  "expo": {
    "name": "Estação Pedro II",
    "slug": "estacao-pedroii",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3F0FA"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F3F0FA"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-maps",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "O app acessa suas fotos para enviar imagens das atrações."
        }
      ],
      "expo-splash-screen",
      "expo-status-bar"
    ]
  }
}