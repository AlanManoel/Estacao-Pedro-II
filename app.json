
{
  "expo": {
    "name": "Estação Pedro II",
    "slug": "estacao-pedroii",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F3F0FA"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.alan_manoel.estacaopedroii"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-maps",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "O app acessa suas fotos para enviar imagens das atrações."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F3F0FA"
        }
      ],
      "expo-status-bar",
      "@maplibre/maplibre-react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "9f7eedf0-86d0-4f8d-93f9-24bb21a9f7e9"
      }
    }
  }
}
